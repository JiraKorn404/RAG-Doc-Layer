# --- Ollama (runs on the Mac, reached over Tailscale) ---
OLLAMA_BASE_URL=http://<mac-tailscale-name>:11434
OLLAMA_TIMEOUT_S=120
OLLAMA_KEEP_ALIVE_S=1800

# --- Models ---
CHAT_MODEL=gemma4:e4b-mlx
VISION_MODEL=gemma4:e4b-mlx
TEXT_EMBED_MODEL=qwen3-embedding:4b
TEXT_EMBED_DIM=2560
IMAGE_EMBED_MODEL=clip-ViT-B-32
IMAGE_EMBED_DIM=512

# --- Milvus (Docker) ---
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530
TEXT_COLLECTION=text_chunks
IMAGE_COLLECTION=image_chunks

# --- PostgreSQL (Docker). Host port 5433 because 5432 is often taken.
# Use 127.0.0.1, not localhost: the ports are published on IPv4 only and localhost tries ::1 first.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=ragdoc
POSTGRES_PASSWORD=ragdoc
POSTGRES_DB=ragdoc

# --- Ingestion ---
CHUNKER=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# CHUNKER is the default strategy (recursive, semantic or llm); each upload can choose another.
# CHUNK_SIZE and CHUNK_OVERLAP above are the recursive defaults; these are the others.
SEMANTIC_BREAKPOINT_PERCENTILE=90
SEMANTIC_BUFFER_SENTENCES=1
SEMANTIC_MIN_CHUNK_CHARS=200
SEMANTIC_MAX_CHUNK_CHARS=2000
LLM_CHUNK_TARGET_CHARS=1000
LLM_CHUNK_MAX_CHARS=2000
LLM_CHUNK_WINDOW_CHARS=6000
CHUNKING_MAX_TOKENS=200
TABLE_MAX_CHARS=4000
MIN_IMAGE_SIDE_PX=64
PDF_IMAGE_SCALE=2.0
EMBED_BATCH_SIZE=16
OCR_DEFAULT=false
PARSE_PAGE_BATCH=4
PARSE_TIMEOUT_S=1800

# --- Retrieval / agent ---
TEXT_TOP_K=5
IMAGE_TOP_K=3
MAX_RETRIES=2
HISTORY_TURNS=6
CHAT_REASONING=true
CONTROL_MAX_TOKENS=300
ANSWER_MAX_TOKENS=4096
MAX_IMAGE_SIDE_PX=1024

# --- Storage on disk ---
DATA_DIR=data
